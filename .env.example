APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# School local time for attendance slots. Use UTC when the OS clock is UTC.
APP_TIMEZONE=Africa/Casablanca

LEARNING_URL=
LEARNING_CLIENT_SECRET=
CENTRAL_AUTH_ACADEMY=auth/academy

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REKOGNITION_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Attendance face matching (Face++ compare against the student's profile photo).
# Missing FACEPP keys keep verification fail-closed (HTTP 503).
FACEPP_API_KEY=
FACEPP_API_SECRET=
FACEPP_API_URL=https://api-us.faceplusplus.com/facepp/v3/compare
FACE_MATCH_THRESHOLD=80
# Set false only for local/dev when Face++ is not configured.
FACE_VERIFICATION_REQUIRED=true
# Optional Rekognition staff enrollment only (not used for check-in).
FACE_VERIFICATION_MIN_SIMILARITY=90

VITE_APP_NAME="${APP_NAME}"



LIONSGEEK_MA_API_URL=
LIONSGEEK_MA_API_KEY=


ABLY_KEY=

# GitHub project activity webhook (HMAC SHA-256). Leave empty until configured.
GITHUB_WEBHOOK_SECRET=

# Agora (voice calling)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Spotify (music stickers on stories) — optional.
# Get a CLIENT_ID + CLIENT_SECRET from https://developer.spotify.com/dashboard
# When empty, music search silently falls back to iTunes only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=


SCHOOL_ALLOWED_IPS=

# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-*.
# Empty = trust none (REMOTE_ADDR only; school Wi-Fi check-in still works on-origin).
# Production behind nginx/Caddy on the same host: TRUSTED_PROXIES=127.0.0.1
# Local tunnel only (ngrok): TRUSTED_PROXIES=* (accepts spoof risk for school.network).
TRUSTED_PROXIES=

